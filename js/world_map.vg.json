{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "World choropleth map of the share of households owning at least one dog or cat in 43 countries with national surveys from 2024 to 2026. A control switches between dogs and cats.",
  "padding": 5,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "title": {
    "text": {
      "signal": "pet === 'Dogs' ? (narrow ? ['Almost half of Australian homes', 'have a dog, more than in most', 'countries compared'] : 'Almost half of Australian homes have a dog, more than in most countries compared') : (narrow ? ['A third of Australian homes', 'have a cat, more than in most', 'countries compared'] : 'A third of Australian homes have a cat, more than in most countries compared')"
    },
    "subtitle": {
      "signal": "narrow ? ['Share of households owning at least one ' + (pet === 'Dogs' ? 'dog' : 'cat') + ',', '43 countries with national surveys, 2024 to', '2026. Grey: no comparable survey.'] : 'Share of households owning at least one ' + (pet === 'Dogs' ? 'dog' : 'cat') + ', 43 countries with national surveys, 2024 to 2026. Grey countries have no comparable survey.'"
    },
    "anchor": "start",
    "offset": 30,
    "font": {
      "signal": "fontHeading"
    },
    "fontSize": {
      "signal": "narrow ? 19 : 24"
    },
    "fontWeight": 400,
    "color": {
      "signal": "colorHeading"
    },
    "subtitleFont": {
      "signal": "fontBody"
    },
    "subtitleFontSize": 13,
    "subtitleColor": {
      "signal": "colorMuted"
    },
    "subtitlePadding": 6
  },
  "signals": [
    {
      "name": "colorPetDogsLight",
      "value": "#fbe8d4",
      "description": "Theme: replaced by --color-pet-dogs-light."
    },
    {
      "name": "colorPetDogs",
      "value": "#9c6500",
      "description": "Theme: replaced by --color-pet-dogs."
    },
    {
      "name": "colorPetDogsDark",
      "value": "#4b2800",
      "description": "Theme: replaced by --color-pet-dogs-dark."
    },
    {
      "name": "colorPetCatsLight",
      "value": "#f8e6f2",
      "description": "Theme: replaced by --color-pet-cats-light."
    },
    {
      "name": "colorPetCats",
      "value": "#7a376b",
      "description": "Theme: replaced by --color-pet-cats."
    },
    {
      "name": "colorPetCatsDark",
      "value": "#4e1f43",
      "description": "Theme: replaced by --color-pet-cats-dark."
    },
    {
      "name": "colorAccent",
      "value": "#005a9c",
      "description": "Theme: replaced by --color-accent (Australia outline)."
    },
    {
      "name": "colorMuted",
      "value": "#252725",
      "description": "Theme: replaced by --color-muted."
    },
    {
      "name": "colorHeading",
      "value": "#0b2540",
      "description": "Theme: replaced by --color-heading."
    },
    {
      "name": "colorBorder",
      "value": "#a4adb8",
      "description": "Theme: replaced by --color-border (no comparable survey)."
    },
    {
      "name": "colorSurface",
      "value": "#ffffff",
      "description": "Theme: replaced by --color-surface."
    },
    {
      "name": "colorPage",
      "value": "#dadfef",
      "description": "Theme: replaced by --color-page."
    },
    {
      "name": "fontHeading",
      "value": "DM Serif Display",
      "description": "Theme: replaced by --font-heading."
    },
    {
      "name": "fontBody",
      "value": "Fira Sans",
      "description": "Theme: replaced by --font-body."
    },
    {
      "name": "pet",
      "value": "Dogs",
      "bind": {
        "input": "radio",
        "options": [
          "Dogs",
          "Cats"
        ],
        "name": "Show "
      }
    },
    {
      "name": "width",
      "init": "containerSize()[0]",
      "on": [
        {
          "events": "window:resize",
          "update": "containerSize()[0]"
        }
      ]
    },
    {
      "name": "narrow",
      "update": "width < 760"
    },
    {
      "name": "worldWidth",
      "update": "width"
    },
    {
      "name": "worldHeight",
      "update": "worldWidth * 0.47",
      "description": "Equal Earth is about twice as wide as it is tall."
    },
    {
      "name": "legendY",
      "update": "worldHeight + 18"
    },
    {
      "name": "legendWidth",
      "update": "narrow ? width : width * 0.6"
    },
    {
      "name": "legendColumns",
      "update": "narrow ? 2 : 3"
    },
    {
      "name": "height",
      "update": "legendY + 22 + 3 * 20"
    },
    {
      "name": "hoverIso",
      "value": null,
      "on": [
        {
          "events": "shape:mouseover",
          "update": "datum.iso"
        },
        {
          "events": "shape:mouseout",
          "update": "null"
        }
      ],
      "description": "Country under the pointer, outlined on the map."
    }
  ],
  "data": [
    {
      "name": "ownership",
      "url": "data/selected/international_dog_cat_selected.csv",
      "format": {
        "type": "csv",
        "parse": {
          "household_ownership_pct": "number"
        }
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.species === pet"
        },
        {
          "type": "formula",
          "as": "iso",
          "expr": "datum.iso3 === 'XKX' ? 'KOS' : datum.iso3",
          "description": "Kosovo uses the user-assigned code XKX in the data and KOS in Natural Earth."
        },
        {
          "type": "formula",
          "as": "country",
          "expr": "{'Rep. of Moldova': 'Republic of Moldova', 'Bosnia & Herzegovina': 'Bosnia and Herzegovina'}[datum.country] || datum.country",
          "description": "Display names in full words (the source abbreviates two)."
        }
      ]
    },
    {
      "name": "countries",
      "url": "data/selected/world_countries.geojson",
      "format": {
        "type": "json",
        "property": "features"
      },
      "transform": [
        {
          "type": "formula",
          "as": "iso",
          "expr": "datum.properties.adm0_a3"
        },
        {
          "type": "lookup",
          "from": "ownership",
          "key": "iso",
          "fields": [
            "iso"
          ],
          "values": [
            "household_ownership_pct",
            "data_year",
            "source_id",
            "country"
          ],
          "as": [
            "value",
            "year",
            "source_id",
            "country"
          ]
        },
        {
          "type": "formula",
          "as": "value_class",
          "expr": "!isValid(datum.value) ? -1 : datum.value < 20 ? 0 : datum.value < 30 ? 1 : datum.value < 40 ? 2 : datum.value < 50 ? 3 : 4"
        },
        {
          "type": "formula",
          "as": "tooltip",
          "expr": "isValid(datum.value) ? {'title': datum.country, 'Pet': pet, 'Share of households owning one': format(datum.value, '.1~f') + '%', 'Survey year': datum.year, 'Source': {'FEDIAF2026': 'European Pet Food Industry Federation, Facts and Figures 2026', 'AMA2025': 'Animal Medicines Australia, Pets in Australia 2025', 'CANZ2024': 'Companion Animals New Zealand, 2024 report', 'UK2026': 'United Kingdom Pet Food, pet population 2026', 'APPA2025': 'American Pet Products Association, 2025 report'}[datum.source_id]} : datum.iso === 'ESP' ? {'title': 'Spain', 'Note': 'Published figure held for review, so not shown'} : indexof(datum.iso, '_OUTSIDE_EUROPE') > 0 ? {'title': datum.properties.name, 'Note': 'Not covered by the European survey figure'} : {'title': datum.properties.name, 'Note': 'No comparable national household survey'}"
        }
      ]
    },
    {
      "name": "australia",
      "source": "countries",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.iso === 'AUS'"
        }
      ]
    },
    {
      "name": "legend",
      "values": [
        {
          "i": 0,
          "label": "Under 20%"
        },
        {
          "i": 1,
          "label": "20% to 29%"
        },
        {
          "i": 2,
          "label": "30% to 39%"
        },
        {
          "i": 3,
          "label": "40% to 49%"
        },
        {
          "i": 4,
          "label": "50% or more"
        },
        {
          "i": 5,
          "label": "No comparable survey"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "steps",
      "type": "linear",
      "domain": {
        "signal": "pet === 'Dogs' ? [0, 2.5, 4] : [0, 3.2, 4]"
      },
      "range": {
        "signal": "pet === 'Dogs' ? [colorPetDogsLight, colorPetDogs, colorPetDogsDark] : [colorPetCatsLight, colorPetCats, colorPetCatsDark]"
      },
      "interpolate": "lab"
    }
  ],
  "projections": [
    {
      "name": "worldProjection",
      "type": "equalEarth",
      "fit": {
        "signal": "{type: 'FeatureCollection', features: data('countries')}"
      },
      "size": {
        "signal": "[worldWidth, worldHeight]"
      }
    }
  ],
  "marks": [
    {
      "type": "group",
      "name": "worldPanel",
      "description": "World map (Equal Earth projection).",
      "clip": true,
      "encode": {
        "update": {
          "x": {
            "signal": "0"
          },
          "y": {
            "signal": "0"
          },
          "width": {
            "signal": "worldWidth"
          },
          "height": {
            "signal": "worldHeight"
          }
        }
      },
      "marks": [
        {
          "type": "shape",
          "name": "worldPanelShapes",
          "from": {
            "data": "countries"
          },
          "encode": {
            "enter": {},
            "update": {
              "fill": {
                "signal": "datum.value_class < 0 ? colorBorder : scale('steps', datum.value_class)"
              },
              "fillOpacity": {
                "signal": "datum.value_class < 0 ? 0.45 : 1"
              },
              "stroke": {
                "signal": "hoverIso === datum.iso && datum.value_class >= 0 ? colorHeading : colorSurface"
              },
              "strokeWidth": {
                "signal": "hoverIso === datum.iso && datum.value_class >= 0 ? 2 : 0.3"
              },
              "zindex": {
                "signal": "hoverIso === datum.iso ? 1 : 0"
              },
              "tooltip": {
                "signal": "datum.tooltip"
              }
            }
          },
          "transform": [
            {
              "type": "geoshape",
              "projection": "worldProjection"
            }
          ]
        }
      ]
    },
    {
      "type": "text",
      "name": "australiaLabel",
      "description": "Label for Australia on the world map.",
      "from": {
        "data": "australia"
      },
      "interactive": false,
      "zindex": 2,
      "encode": {
        "enter": {
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 600
          },
          "baseline": {
            "value": "middle"
          },
          "align": {
            "value": "right"
          }
        },
        "update": {
          "x": {
            "signal": "geoBounds('worldProjection', datum)[0][0] - 6"
          },
          "y": {
            "signal": "geoCentroid('worldProjection', datum)[1]"
          },
          "text": {
            "signal": "'Australia ' + format(datum.value, '.0f') + '%'"
          },
          "font": {
            "signal": "fontBody"
          },
          "fill": {
            "signal": "colorAccent"
          }
        }
      }
    },
    {
      "type": "rect",
      "description": "Plain background behind the Australia label; no outline or shadow.",
      "from": {
        "data": "australiaLabel"
      },
      "interactive": false,
      "zindex": 1,
      "encode": {
        "update": {
          "x": {
            "signal": "datum.bounds.x1 - 4"
          },
          "x2": {
            "signal": "datum.bounds.x2 + 4"
          },
          "y": {
            "signal": "datum.bounds.y1 - 2"
          },
          "y2": {
            "signal": "datum.bounds.y2 + 2"
          },
          "fill": {
            "signal": "colorSurface"
          },
          "fillOpacity": {
            "value": 0.85
          },
          "cornerRadius": {
            "value": 3
          }
        }
      }
    },
    {
      "type": "text",
      "description": "Legend title.",
      "encode": {
        "enter": {
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 600
          },
          "baseline": {
            "value": "top"
          }
        },
        "update": {
          "x": {
            "value": 0
          },
          "y": {
            "signal": "legendY"
          },
          "text": {
            "signal": "'Households owning at least one ' + (pet === 'Dogs' ? 'dog' : 'cat')"
          },
          "font": {
            "signal": "fontBody"
          },
          "fill": {
            "signal": "colorMuted"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "legend"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "datum.i % legendColumns * (legendWidth / legendColumns)"
          },
          "y": {
            "signal": "legendY + 22 + floor(datum.i / legendColumns) * 20"
          },
          "width": {
            "value": 14
          },
          "height": {
            "value": 14
          },
          "fill": {
            "signal": "datum.i > 4 ? colorBorder : scale('steps', datum.i)"
          },
          "fillOpacity": {
            "signal": "datum.i > 4 ? 0.45 : 1"
          },
          "stroke": {
            "signal": "colorBorder"
          },
          "strokeWidth": {
            "value": 0.5
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "legend"
      },
      "interactive": false,
      "encode": {
        "enter": {
          "fontSize": {
            "value": 11
          },
          "baseline": {
            "value": "middle"
          },
          "text": {
            "field": "label"
          }
        },
        "update": {
          "x": {
            "signal": "datum.i % legendColumns * (legendWidth / legendColumns) + 19"
          },
          "y": {
            "signal": "legendY + 22 + floor(datum.i / legendColumns) * 20 + 7"
          },
          "font": {
            "signal": "fontBody"
          },
          "fill": {
            "signal": "colorMuted"
          }
        }
      }
    }
  ]
}
