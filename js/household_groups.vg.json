{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Grouped lollipop chart of pet ownership for eight Australian household groups, each drawn from the national rate of 73%, Animal Medicines Australia survey 2025.",
  "padding": 5,
  "autosize": {"type": "fit-x", "contains": "padding"},

  "title": {
    "text": {"signal": "narrow ? ['In every comparison, one group', 'sits above the national rate', 'and one below'] : 'In every comparison, one group sits above the national rate and one below'"},
    "subtitle": {"signal": "narrow ? ['Share of households owning at least one pet,', 'by household group, 2025'] : 'Share of households owning at least one pet, by household group, 2025'"},
    "anchor": "start",
    "offset": 30,
    "font": {"signal": "fontHeading"},
    "fontSize": {"signal": "narrow ? 19 : 24"},
    "fontWeight": 400,
    "color": {"signal": "colorHeading"},
    "subtitleFont": {"signal": "fontBody"},
    "subtitleFontSize": 13,
    "subtitleColor": {"signal": "colorMuted"},
    "subtitlePadding": 6
  },

  "signals": [
    {"name": "colorNeutral", "value": "#512D22", "description": "Theme: replaced by --color-neutral from css/style.css."},
    {"name": "colorAccent", "value": "#005a9c", "description": "Theme: replaced by --color-accent (highlighted comparison)."},
    {"name": "colorMuted", "value": "#252725", "description": "Theme: replaced by --color-muted."},
    {"name": "colorHeading", "value": "#0b2540", "description": "Theme: replaced by --color-heading."},
    {"name": "colorPage", "value": "#dadfef", "description": "Theme: replaced by --color-page."},
    {"name": "fontHeading", "value": "DM Serif Display", "description": "Theme: replaced by --font-heading."},
    {"name": "fontBody", "value": "Fira Sans", "description": "Theme: replaced by --font-body."},
    {
      "name": "width",
      "init": "containerSize()[0]",
      "on": [{"events": "window:resize", "update": "containerSize()[0]"}]
    },
    {"name": "narrow", "update": "width < 760"},
    {"name": "nationalRate", "value": 73},
    {"name": "leaderAt", "update": "narrow ? 95.5 : 91.5", "description": "Axis position of the leader line, right of every value label."},
    {"name": "highlight", "value": "Household", "description": "Comparison emphasised to match the annotation."},
    {"name": "labelWidth", "update": "narrow ? 0 : 300", "description": "Desktop: column for group names; narrow screens put names above each lollipop."},
    {"name": "headerHeight", "update": "narrow ? 24 : 26"},
    {"name": "rowHeight", "update": "narrow ? 44 : 30"},
    {"name": "blockGap", "update": "narrow ? 12 : 16"},
    {"name": "blockHeight", "update": "headerHeight + 2 * rowHeight + blockGap"},
    {"name": "plotHeight", "update": "4 * blockHeight - blockGap"},
    {"name": "noteTop", "update": "plotHeight + 56", "description": "Top edge of the note background."},
    {"name": "height", "update": "plotHeight + (narrow ? 205 : 112)"}
  ],

  "data": [
    {
      "name": "groups",
      "url": "data/selected/au_selected_demographics_2025.csv",
      "format": {"type": "csv", "parse": {"any_pet_ownership_pct": "number"}},
      "transform": [
        {"type": "formula", "as": "pct", "expr": "datum.any_pet_ownership_pct"},
        {
          "type": "formula",
          "as": "label",
          "expr": "{'Apartment/unit': 'Apartments or units', 'Own outright': 'Own their home outright', 'Families with kids at home': 'Families with children at home', 'Living alone/couples without kids': 'Living alone or couples without children', 'At least AUD 100000 annually': '$100,000 or more a year', 'Below AUD 50000 annually': 'Under $50,000 a year'}[datum.group] || datum.group"
        },
        {"type": "formula", "as": "dimension_label", "expr": "{'Housing': 'Type of home', 'Tenure': 'Home ownership', 'Household': 'Household make-up', 'Income': 'Household income'}[datum.dimension]"},
        {"type": "formula", "as": "block", "expr": "indexof(['Housing', 'Tenure', 'Household', 'Income'], datum.dimension)"},
        {"type": "window", "groupby": ["dimension"], "sort": {"field": "pct", "order": "descending"}, "ops": ["row_number"], "as": ["rank"]},
        {"type": "formula", "as": "difference", "expr": "datum.pct - nationalRate"},
        {"type": "formula", "as": "emphasis", "expr": "datum.dimension === highlight"},
        {
          "type": "formula",
          "as": "tooltip",
          "expr": "{'Group': datum.label, 'Households owning a pet': datum.pct + '%', 'Compared with the national rate': (datum.difference > 0 ? datum.difference + ' points above' : -datum.difference + ' points below') + ' (' + nationalRate + '%)', 'Source of value': datum.derivation === 'reported' ? 'Published in the report' : 'Calculated as 100% minus the published share of non-owners'}"
        }
      ]
    },
    {
      "name": "blocks",
      "source": "groups",
      "transform": [{"type": "aggregate", "groupby": ["dimension", "dimension_label", "block", "emphasis"]}]
    },
    {
      "name": "note",
      "values": [
        {
          "lines": [
            "Household make-up: a 20-point gap. Families with children under 18 are also around twice as likely",
            "to be planning to get a pet (67%) as couples without children (39%) or people living alone (36%).",
            "The report does not give a reason, so this shows who owns pets, not what causes it."
          ],
          "short": [
            "Household make-up: a 20-point gap.",
            "Families with children under 18 are",
            "also around twice as likely to be",
            "planning to get a pet (67%) as couples",
            "without children (39%) or people",
            "living alone (36%). The report gives",
            "no reason, so this shows who owns",
            "pets, not what causes it."
          ]
        }
      ]
    }
  ],

  "scales": [
    {"name": "x", "type": "linear", "domain": {"signal": "narrow ? [50, 97] : [50, 92]"}, "range": [{"signal": "labelWidth"}, {"signal": "width"}], "zero": false}
  ],

  "marks": [
    {
      "type": "group",
      "description": "Plot area: comparison blocks, lollipops, national rate and axis.",
      "encode": {"update": {"x": {"value": 0}, "y": {"value": 0}, "width": {"signal": "width"}, "height": {"signal": "plotHeight"}}},
      "axes": [
        {
          "orient": "bottom",
          "scale": "x",
          "values": {"signal": "narrow ? [50, 60, 70, 80] : [50, 60, 70, 80, 90]"},
          "domain": false,
          "ticks": false,
          "grid": false,
          "labelPadding": 8,
          "labelColor": {"signal": "colorMuted"},
          "labelFont": {"signal": "fontBody"},
          "labelFontSize": 12,
          "title": "Households owning at least one pet",
          "titleColor": {"signal": "colorMuted"},
          "titleFont": {"signal": "fontBody"},
          "titleFontSize": 13,
          "titleFontWeight": 500,
          "titlePadding": 8,
          "encode": {"labels": {"update": {"text": {"signal": "datum.value + '%'"}}}}
        }
      ],
      "marks": [
        {
          "type": "rule",
          "description": "Desktop: national rate as one continuous dashed line.",
          "encode": {
            "enter": {"stroke": {"signal": "colorMuted"}, "strokeWidth": {"value": 1.5}, "strokeDash": {"value": [4, 4]}},
            "update": {"x": {"scale": "x", "signal": "nationalRate"}, "y": {"value": 0}, "y2": {"signal": "plotHeight"}, "strokeOpacity": {"signal": "narrow ? 0 : 1"}}
          }
        },
        {
          "type": "rule",
          "description": "Narrow screens: national rate drawn only beside each lollipop so it never crosses the group names above them.",
          "from": {"data": "groups"},
          "encode": {
            "enter": {"stroke": {"signal": "colorMuted"}, "strokeWidth": {"value": 1.5}, "strokeDash": {"value": [4, 4]}},
            "update": {
              "x": {"scale": "x", "signal": "nationalRate"},
              "y": {"signal": "datum.block * blockHeight + headerHeight + (datum.rank - 1) * rowHeight + 30 - 12"},
              "y2": {"signal": "datum.block * blockHeight + headerHeight + (datum.rank - 1) * rowHeight + 30 + 12"},
              "strokeOpacity": {"signal": "narrow ? 1 : 0"}
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "enter": {"align": {"value": "center"}, "baseline": {"value": "bottom"}, "fontSize": {"value": 12}, "fontWeight": {"value": 500}, "font": {"signal": "fontBody"}, "fill": {"signal": "colorMuted"}},
            "update": {"x": {"scale": "x", "signal": "nationalRate"}, "y": {"value": -6}, "text": {"signal": "'National rate ' + nationalRate + '%'"}}
          }
        },
        {
          "type": "text",
          "description": "Comparison headings.",
          "from": {"data": "blocks"},
          "encode": {
            "enter": {"align": {"value": "left"}, "baseline": {"value": "top"}, "fontSize": {"value": 13}, "fontWeight": {"value": 600}, "font": {"signal": "fontBody"}, "text": {"field": "dimension_label"}},
            "update": {
              "x": {"value": 0},
              "y": {"signal": "datum.block * blockHeight + 4"},
              "fill": {"signal": "datum.emphasis ? colorAccent : colorMuted"}
            }
          }
        },
        {
          "type": "text",
          "description": "Group names: left column on desktop, above each lollipop on narrow screens.",
          "from": {"data": "groups"},
          "encode": {
            "enter": {"baseline": {"value": "middle"}, "font": {"signal": "fontBody"}, "text": {"field": "label"}},
            "update": {
              "x": {"signal": "narrow ? 0 : labelWidth - 16"},
              "y": {"signal": "datum.block * blockHeight + headerHeight + (datum.rank - 1) * rowHeight + (narrow ? 10 : rowHeight / 2)"},
              "align": {"signal": "narrow ? 'left' : 'right'"},
              "fontSize": {"signal": "narrow ? 12 : 13"},
              "fontWeight": {"signal": "datum.emphasis ? 600 : 400"},
              "fill": {"signal": "datum.emphasis ? colorAccent : colorMuted"}
            }
          }
        },
        {
          "type": "rule",
          "description": "Lollipop stick from the national rate to the group's value.",
          "from": {"data": "groups"},
          "encode": {
            "enter": {"strokeWidth": {"value": 3}, "strokeCap": {"value": "butt"}},
            "update": {
              "x": {"scale": "x", "signal": "nationalRate"},
              "x2": {"scale": "x", "field": "pct"},
              "y": {"signal": "datum.block * blockHeight + headerHeight + (datum.rank - 1) * rowHeight + (narrow ? 30 : rowHeight / 2)"},
              "stroke": {"signal": "datum.emphasis ? colorAccent : colorNeutral"}
            }
          }
        },
        {
          "type": "symbol",
          "description": "Lollipop head at the group's value.",
          "from": {"data": "groups"},
          "encode": {
            "enter": {"tooltip": {"signal": "datum.tooltip"}},
            "update": {
              "x": {"scale": "x", "field": "pct"},
              "y": {"signal": "datum.block * blockHeight + headerHeight + (datum.rank - 1) * rowHeight + (narrow ? 30 : rowHeight / 2)"},
              "size": {"value": 130},
              "fill": {"signal": "datum.emphasis ? colorAccent : colorNeutral"}
            }
          }
        },
        {
          "type": "text",
          "name": "valueLabel",
          "description": "Value beyond each lollipop head, on the side it points.",
          "from": {"data": "groups"},
          "encode": {
            "enter": {"baseline": {"value": "middle"}, "fontSize": {"value": 13}, "font": {"signal": "fontBody"}},
            "update": {
              "x": {"scale": "x", "field": "pct", "offset": {"signal": "datum.difference > 0 ? 11 : -11"}},
              "y": {"signal": "datum.block * blockHeight + headerHeight + (datum.rank - 1) * rowHeight + (narrow ? 30 : rowHeight / 2)"},
              "align": {"signal": "datum.difference > 0 ? 'left' : 'right'"},
              "text": {"signal": "datum.pct + '%'"},
              "fontWeight": {"signal": "datum.emphasis ? 600 : 400"},
              "fill": {"signal": "datum.emphasis ? colorAccent : colorMuted"}
            }
          }
        },
        {
          "type": "rule",
          "description": "Leader from the note up the right edge to the highlighted comparison.",
          "from": {"data": "valueLabel"},
          "interactive": false,
          "encode": {
            "enter": {"stroke": {"signal": "colorMuted"}, "strokeWidth": {"value": 1}},
            "update": {
              "x": {"scale": "x", "signal": "leaderAt"},
              "y": {"signal": "noteTop"},
              "x2": {"scale": "x", "signal": "leaderAt"},
              "y2": {"signal": "datum.y"},
              "strokeOpacity": {"signal": "datum.datum.emphasis && datum.datum.rank === 1 ? 1 : 0"}
            }
          }
        },
        {
          "type": "rule",
          "description": "Leader: short horizontal segment ending just after the highlighted value label.",
          "from": {"data": "valueLabel"},
          "interactive": false,
          "encode": {
            "enter": {"stroke": {"signal": "colorMuted"}, "strokeWidth": {"value": 1}},
            "update": {
              "x": {"scale": "x", "signal": "leaderAt"},
              "x2": {"signal": "datum.bounds.x2 + 6"},
              "y": {"signal": "datum.y"},
              "y2": {"signal": "datum.y"},
              "strokeOpacity": {"signal": "datum.datum.emphasis && datum.datum.rank === 1 ? 1 : 0"}
            }
          }
        }
      ]
    },
    {
      "type": "text",
      "name": "noteText",
      "from": {"data": "note"},
      "zindex": 2,
      "encode": {
        "enter": {"align": {"value": "left"}, "baseline": {"value": "top"}, "lineHeight": {"value": 17}, "fontSize": {"value": 12}, "font": {"signal": "fontBody"}, "fontStyle": {"value": "italic"}, "fill": {"signal": "colorMuted"}},
        "update": {
          "x": {"value": 8},
          "y": {"signal": "noteTop + 6"},
          "text": {"signal": "narrow ? datum.short : datum.lines"}
        }
      }
    },
    {
      "description": "Plain background sized to the note text; no outline or shadow.",
      "type": "rect",
      "from": {"data": "noteText"},
      "zindex": 1,
      "encode": {
        "enter": {"fill": {"signal": "colorPage"}, "cornerRadius": {"value": 4}},
        "update": {
          "x": {"value": 0},
          "x2": {"signal": "narrow ? width : max(datum.bounds.x2 + 8, scale('x', leaderAt) + 12)"},
          "y": {"signal": "noteTop"},
          "y2": {"signal": "datum.bounds.y2 + 6"}
        }
      }
    }
  ]
}
