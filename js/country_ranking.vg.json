{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Ranked dot plot of the share of households owning at least one dog and at least one cat in 43 countries with national surveys from 2024 to 2026, with Australia highlighted. A control re-ranks the countries by dogs or cats.",
  "padding": 5,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "title": {
    "text": {
      "signal": "narrow ? ['Australia ranks fourth of 43', 'countries for dogs and eighth', 'for cats'] : 'Australia ranks fourth of 43 countries for dogs and eighth for cats'"
    },
    "subtitle": {
      "signal": "narrow ? ['Share of households owning at least one dog', 'or cat, national surveys from 2024 to 2026,', 'ranked by ' + (sortBy === 'Dogs' ? 'dogs' : 'cats')] : 'Share of households owning at least one dog or cat, national surveys from 2024 to 2026, ranked by ' + (sortBy === 'Dogs' ? 'dogs' : 'cats')"
    },
    "anchor": "start",
    "offset": 16,
    "font": {
      "signal": "fontHeading"
    },
    "fontSize": {
      "signal": "narrow ? 19 : 24"
    },
    "fontWeight": 400,
    "color": {
      "signal": "colorHeading"
    },
    "subtitleFont": {
      "signal": "fontBody"
    },
    "subtitleFontSize": 13,
    "subtitleColor": {
      "signal": "colorMuted"
    },
    "subtitlePadding": 6
  },
  "signals": [
    {
      "name": "colorPetDogs",
      "value": "#9c6500",
      "description": "Theme: replaced by --color-pet-dogs."
    },
    {
      "name": "colorPetCats",
      "value": "#7a376b",
      "description": "Theme: replaced by --color-pet-cats."
    },
    {
      "name": "colorNeutral",
      "value": "#512D22",
      "description": "Theme: replaced by --color-neutral."
    },
    {
      "name": "colorAccent",
      "value": "#005a9c",
      "description": "Theme: replaced by --color-accent (Australia)."
    },
    {
      "name": "colorMuted",
      "value": "#252725",
      "description": "Theme: replaced by --color-muted."
    },
    {
      "name": "colorHeading",
      "value": "#0b2540",
      "description": "Theme: replaced by --color-heading."
    },
    {
      "name": "colorBorder",
      "value": "#a4adb8",
      "description": "Theme: replaced by --color-border."
    },
    {
      "name": "colorPage",
      "value": "#dadfef",
      "description": "Theme: replaced by --color-page."
    },
    {
      "name": "fontHeading",
      "value": "DM Serif Display",
      "description": "Theme: replaced by --font-heading."
    },
    {
      "name": "fontBody",
      "value": "Fira Sans",
      "description": "Theme: replaced by --font-body."
    },
    {
      "name": "sortBy",
      "value": "Dogs",
      "bind": {
        "input": "radio",
        "options": [
          "Dogs",
          "Cats"
        ],
        "name": "Sort by "
      }
    },
    {
      "name": "width",
      "init": "containerSize()[0]",
      "on": [
        {
          "events": "window:resize",
          "update": "containerSize()[0]"
        }
      ]
    },
    {
      "name": "narrow",
      "update": "width < 760"
    },
    {
      "name": "labelWidth",
      "update": "narrow ? 112 : 150",
      "description": "Column for country names."
    },
    {
      "name": "noteWidth",
      "update": "narrow ? 0 : 300",
      "description": "Desktop: column for the Australia note."
    },
    {
      "name": "rowHeight",
      "update": "narrow ? 20 : 19"
    },
    {
      "name": "plotHeight",
      "update": "43 * rowHeight"
    },
    {
      "name": "legendY",
      "update": "plotHeight + 56"
    },
    {
      "name": "height",
      "update": "legendY + (narrow ? 118 : 24)"
    }
  ],
  "data": [
    {
      "name": "countries",
      "url": "data/selected/international_dog_cat_selected.csv",
      "format": {
        "type": "csv",
        "parse": {
          "household_ownership_pct": "number"
        }
      },
      "transform": [
        {
          "type": "formula",
          "as": "country",
          "expr": "{'Rep. of Moldova': 'Republic of Moldova', 'Bosnia & Herzegovina': 'Bosnia and Herzegovina'}[datum.country] || datum.country",
          "description": "Display names in full words (the source abbreviates two)."
        },
        {
          "type": "pivot",
          "field": "species",
          "value": "household_ownership_pct",
          "groupby": [
            "iso3",
            "country",
            "data_year",
            "source_id"
          ],
          "op": "max"
        },
        {
          "type": "formula",
          "as": "australia",
          "expr": "datum.iso3 === 'AUS'"
        },
        {
          "type": "formula",
          "as": "low",
          "expr": "min(datum.Dogs, datum.Cats)"
        },
        {
          "type": "formula",
          "as": "high",
          "expr": "max(datum.Dogs, datum.Cats)"
        },
        {
          "type": "formula",
          "as": "sort_key",
          "expr": "sortBy === 'Dogs' ? -datum.Dogs - datum.Cats / 1000 : -datum.Cats - datum.Dogs / 1000",
          "description": "Ranks by the chosen pet; ties broken by the other pet."
        },
        {
          "type": "formula",
          "as": "source",
          "expr": "{'FEDIAF2026': 'European Pet Food Industry Federation, Facts and Figures 2026', 'AMA2025': 'Animal Medicines Australia, Pets in Australia 2025', 'CANZ2024': 'Companion Animals New Zealand, 2024 report', 'UK2026': 'United Kingdom Pet Food, pet population 2026', 'APPA2025': 'American Pet Products Association, 2025 report'}[datum.source_id]"
        },
        {
          "type": "formula",
          "as": "tooltip",
          "expr": "{'title': datum.country, 'Households with a dog': format(datum.Dogs, '.1~f') + '%', 'Households with a cat': format(datum.Cats, '.1~f') + '%', 'Survey year': datum.data_year, 'Source': datum.source}"
        }
      ]
    },
    {
      "name": "dots",
      "source": "countries",
      "transform": [
        {
          "type": "fold",
          "fields": [
            "Dogs",
            "Cats"
          ],
          "as": [
            "pet",
            "share"
          ]
        }
      ]
    },
    {
      "name": "australia",
      "source": "countries",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.australia"
        }
      ]
    },
    {
      "name": "legend",
      "values": [
        {
          "pet": "Dogs",
          "order": 0
        },
        {
          "pet": "Cats",
          "order": 1
        }
      ]
    },
    {
      "name": "note",
      "values": [
        {
          "lines": [
            "Australia: 49% of homes have a dog (fourth",
            "of 43) and 34% have a cat (eighth). Only",
            "Poland, the United States and Hungary",
            "report a higher share of homes with dogs."
          ]
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "y",
      "type": "band",
      "domain": {
        "data": "countries",
        "field": "country",
        "sort": {
          "field": "sort_key",
          "op": "min",
          "order": "ascending"
        }
      },
      "range": [
        0,
        {
          "signal": "plotHeight"
        }
      ],
      "paddingInner": 0,
      "paddingOuter": 0
    },
    {
      "name": "x",
      "type": "linear",
      "domain": [
        0,
        60
      ],
      "range": [
        {
          "signal": "labelWidth"
        },
        {
          "signal": "width - noteWidth - (narrow ? 8 : 40)"
        }
      ],
      "zero": true
    },
    {
      "name": "petColour",
      "type": "ordinal",
      "domain": [
        "Dogs",
        "Cats"
      ],
      "range": {
        "signal": "[colorPetDogs, colorPetCats]"
      }
    }
  ],
  "marks": [
    {
      "type": "group",
      "description": "Plot area: rows, dots and axis.",
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "y": {
            "value": 0
          },
          "width": {
            "signal": "width"
          },
          "height": {
            "signal": "plotHeight"
          }
        }
      },
      "axes": [
        {
          "orient": "bottom",
          "scale": "x",
          "values": {
            "signal": "narrow ? [0, 20, 40, 60] : [0, 10, 20, 30, 40, 50, 60]"
          },
          "grid": true,
          "gridColor": {
            "signal": "colorBorder"
          },
          "gridOpacity": 0.45,
          "domain": false,
          "ticks": false,
          "labelPadding": 8,
          "labelColor": {
            "signal": "colorMuted"
          },
          "labelFont": {
            "signal": "fontBody"
          },
          "labelFontSize": 12,
          "title": {
            "signal": "narrow ? 'Share of households' : 'Share of households owning at least one dog or cat'"
          },
          "titleColor": {
            "signal": "colorMuted"
          },
          "titleFont": {
            "signal": "fontBody"
          },
          "titleFontSize": 13,
          "titleFontWeight": 500,
          "titlePadding": 8,
          "encode": {
            "labels": {
              "update": {
                "text": {
                  "signal": "datum.value + '%'"
                }
              }
            }
          }
        }
      ],
      "marks": [
        {
          "type": "rect",
          "description": "Plain background band marking Australia's row.",
          "from": {
            "data": "australia"
          },
          "interactive": false,
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "x2": {
                "scale": "x",
                "value": 60
              },
              "y": {
                "scale": "y",
                "field": "country"
              },
              "height": {
                "scale": "y",
                "band": 1
              },
              "fill": {
                "signal": "colorPage"
              },
              "cornerRadius": {
                "value": 3
              }
            }
          }
        },
        {
          "type": "text",
          "description": "Country names.",
          "from": {
            "data": "countries"
          },
          "encode": {
            "enter": {
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              }
            },
            "update": {
              "x": {
                "signal": "labelWidth - 10"
              },
              "y": {
                "scale": "y",
                "field": "country",
                "band": 0.5
              },
              "text": {
                "field": "country"
              },
              "font": {
                "signal": "fontBody"
              },
              "fontSize": {
                "signal": "narrow ? 11 : 12"
              },
              "fontWeight": {
                "signal": "datum.australia ? 600 : 400"
              },
              "fill": {
                "signal": "datum.australia ? colorAccent : colorMuted"
              }
            }
          }
        },
        {
          "type": "rule",
          "description": "Light connector between each country's dog and cat shares.",
          "from": {
            "data": "countries"
          },
          "interactive": false,
          "encode": {
            "enter": {
              "stroke": {
                "signal": "colorNeutral"
              },
              "strokeOpacity": {
                "value": 0.25
              },
              "strokeWidth": {
                "value": 3
              }
            },
            "update": {
              "x": {
                "scale": "x",
                "field": "low"
              },
              "x2": {
                "scale": "x",
                "field": "high"
              },
              "y": {
                "scale": "y",
                "field": "country",
                "band": 0.5
              }
            }
          }
        },
        {
          "type": "symbol",
          "description": "Dog and cat dots in the fixed pet colours.",
          "from": {
            "data": "dots"
          },
          "encode": {
            "enter": {
              "tooltip": {
                "signal": "datum.tooltip"
              }
            },
            "update": {
              "x": {
                "scale": "x",
                "field": "share"
              },
              "y": {
                "scale": "y",
                "field": "country",
                "band": 0.5
              },
              "size": {
                "signal": "datum.australia ? 110 : (narrow ? 44 : 56)"
              },
              "fill": {
                "scale": "petColour",
                "field": "pet"
              }
            }
          }
        },
        {
          "type": "text",
          "name": "australiaValues",
          "description": "Values for Australia only: the higher share to the right, the lower to the left.",
          "from": {
            "data": "dots"
          },
          "interactive": false,
          "encode": {
            "enter": {
              "baseline": {
                "value": "middle"
              },
              "fontWeight": {
                "value": 600
              },
              "fontSize": {
                "value": 12
              }
            },
            "update": {
              "x": {
                "scale": "x",
                "field": "share",
                "offset": {
                  "signal": "datum.share === datum.high ? 10 : -10"
                }
              },
              "y": {
                "scale": "y",
                "field": "country",
                "band": 0.5
              },
              "align": {
                "signal": "datum.share === datum.high ? 'left' : 'right'"
              },
              "text": {
                "signal": "datum.australia ? format(datum.share, '.0f') + '%' : ''"
              },
              "font": {
                "signal": "fontBody"
              },
              "fill": {
                "scale": "petColour",
                "field": "pet"
              }
            }
          }
        },
        {
          "type": "rule",
          "description": "Desktop leader from Australia's row to the note.",
          "from": {
            "data": "australia"
          },
          "interactive": false,
          "encode": {
            "enter": {
              "stroke": {
                "signal": "colorMuted"
              },
              "strokeWidth": {
                "value": 1
              }
            },
            "update": {
              "x": {
                "signal": "scale('x', datum.high) + 42"
              },
              "x2": {
                "signal": "width - noteWidth + 6"
              },
              "y": {
                "scale": "y",
                "field": "country",
                "band": 0.5
              },
              "strokeOpacity": {
                "signal": "narrow ? 0 : 1"
              }
            }
          }
        }
      ]
    },
    {
      "type": "text",
      "name": "noteText",
      "from": {
        "data": "note"
      },
      "zindex": 2,
      "encode": {
        "enter": {
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "top"
          },
          "lineHeight": {
            "value": 17
          },
          "fontSize": {
            "value": 12
          },
          "fontStyle": {
            "value": "italic"
          },
          "text": {
            "field": "lines"
          }
        },
        "update": {
          "x": {
            "signal": "narrow ? 8 : width - noteWidth + 22"
          },
          "y": {
            "signal": "narrow ? legendY + 40 : scale('y', data('australia')[0].country) + bandwidth('y') / 2 - 10"
          },
          "font": {
            "signal": "fontBody"
          },
          "fill": {
            "signal": "colorMuted"
          }
        }
      }
    },
    {
      "description": "Plain background sized to the note text; no outline or shadow.",
      "type": "rect",
      "from": {
        "data": "noteText"
      },
      "zindex": 1,
      "encode": {
        "enter": {
          "cornerRadius": {
            "value": 4
          }
        },
        "update": {
          "x": {
            "signal": "datum.bounds.x1 - 8"
          },
          "x2": {
            "signal": "datum.bounds.x2 + 8"
          },
          "y": {
            "signal": "datum.bounds.y1 - 6"
          },
          "y2": {
            "signal": "datum.bounds.y2 + 6"
          },
          "fill": {
            "signal": "colorPage"
          }
        }
      }
    },
    {
      "type": "symbol",
      "description": "Legend below the x-axis title.",
      "from": {
        "data": "legend"
      },
      "interactive": false,
      "encode": {
        "enter": {
          "size": {
            "value": 90
          }
        },
        "update": {
          "x": {
            "signal": "(labelWidth + width - noteWidth) / 2 - 40 + datum.order * 70"
          },
          "y": {
            "signal": "legendY"
          },
          "fill": {
            "scale": "petColour",
            "field": "pet"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "legend"
      },
      "interactive": false,
      "encode": {
        "enter": {
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": 600
          }
        },
        "update": {
          "x": {
            "signal": "(labelWidth + width - noteWidth) / 2 - 30 + datum.order * 70"
          },
          "y": {
            "signal": "legendY"
          },
          "text": {
            "field": "pet"
          },
          "font": {
            "signal": "fontBody"
          },
          "fill": {
            "scale": "petColour",
            "field": "pet"
          }
        }
      }
    }
  ]
}
