{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Proportional symbol map of dogs recorded at home in South Australian councils, 2025: circle area shows the number of dogs. On the main map Greater Adelaide's 18 councils are combined into one circle; an inset shows them individually.",
  "padding": 5,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "title": {
    "text": {
      "signal": "narrow ? ['In total, most of the state\\'s', 'dogs live in Greater Adelaide'] : 'In total, most of the state\\'s dogs live in Greater Adelaide'"
    },
    "subtitle": {
      "signal": "narrow ? ['Dogs recorded at home by council, 2025;', 'circle area shows the number of dogs'] : 'Dogs recorded at home by South Australian council, 2025; each circle\\'s area shows the number of dogs'"
    },
    "anchor": "start",
    "offset": 16,
    "font": {
      "signal": "fontHeading"
    },
    "fontSize": {
      "signal": "narrow ? 19 : 24"
    },
    "fontWeight": 400,
    "color": {
      "signal": "colorHeading"
    },
    "subtitleFont": {
      "signal": "fontBody"
    },
    "subtitleFontSize": 13,
    "subtitleColor": {
      "signal": "colorMuted"
    },
    "subtitlePadding": 6
  },
  "signals": [
    {
      "name": "colorPetDogs",
      "value": "#9c6500",
      "description": "Theme: replaced by --color-pet-dogs (circles)."
    },
    {
      "name": "colorMuted",
      "value": "#252725",
      "description": "Theme: replaced by --color-muted."
    },
    {
      "name": "colorHeading",
      "value": "#0b2540",
      "description": "Theme: replaced by --color-heading."
    },
    {
      "name": "colorBorder",
      "value": "#a4adb8",
      "description": "Theme: replaced by --color-border (basemap)."
    },
    {
      "name": "colorSurface",
      "value": "#ffffff",
      "description": "Theme: replaced by --color-surface."
    },
    {
      "name": "colorPage",
      "value": "#dadfef",
      "description": "Theme: replaced by --color-page (note background)."
    },
    {
      "name": "fontHeading",
      "value": "DM Serif Display",
      "description": "Theme: replaced by --font-heading."
    },
    {
      "name": "fontBody",
      "value": "Fira Sans",
      "description": "Theme: replaced by --font-body."
    },
    {
      "name": "width",
      "init": "containerSize()[0]",
      "on": [
        {
          "events": "window:resize",
          "update": "containerSize()[0]"
        }
      ]
    },
    {
      "name": "narrow",
      "update": "width < 760"
    },
    {
      "name": "rMax",
      "update": "narrow ? 30 : 46",
      "description": "Radius of the largest circle (Greater Adelaide, 200,163 dogs)."
    },
    {
      "name": "mainWidth",
      "update": "narrow ? width : width * 0.58"
    },
    {
      "name": "mainHeight",
      "update": "mainWidth * 0.98"
    },
    {
      "name": "sideX",
      "update": "narrow ? 0 : mainWidth + 28"
    },
    {
      "name": "sideY",
      "update": "narrow ? mainHeight + 18 : 0"
    },
    {
      "name": "sideWidth",
      "update": "narrow ? width : width - sideX"
    },
    {
      "name": "insetHeight",
      "update": "narrow ? width * 1.05 : mainHeight * 0.74"
    },
    {
      "name": "noteY",
      "update": "narrow ? sideY + insetHeight + 16 : sideY + insetHeight + 16"
    },
    {
      "name": "legendY",
      "update": "narrow ? noteY + 112 : mainHeight + 18"
    },
    {
      "name": "height",
      "update": "legendY + 22 + 2 * rMax + 24"
    },
    {
      "name": "hoverCode",
      "value": null,
      "on": [
        {
          "events": "symbol:mouseover",
          "update": "datum.code"
        },
        {
          "events": "symbol:mouseout",
          "update": "null"
        }
      ],
      "description": "Council under the pointer, outlined."
    }
  ],
  "data": [
    {
      "name": "rates",
      "url": "data/selected/sa_council_animals_per_1000_residents_2025.csv",
      "format": {
        "type": "csv",
        "parse": {
          "recorded_animals_per_1000_residents": "number",
          "recorded_at_home_animals": "number",
          "residents_2025": "number"
        }
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.species === 'Dog'"
        },
        {
          "type": "formula",
          "as": "code",
          "expr": "'' + datum.lga_code_2025"
        }
      ]
    },
    {
      "name": "councils",
      "url": "data/selected/sa_council_boundaries_2025.geojson",
      "format": {
        "type": "json",
        "property": "features"
      },
      "transform": [
        {
          "type": "formula",
          "as": "code",
          "expr": "'' + datum.properties.lga_code_2025"
        },
        {
          "type": "formula",
          "as": "name",
          "expr": "replace(datum.properties.lga_name_2025, ' (SA)', '')"
        },
        {
          "type": "lookup",
          "from": "rates",
          "key": "code",
          "fields": [
            "code"
          ],
          "values": [
            "recorded_at_home_animals",
            "recorded_animals_per_1000_residents",
            "residents_2025"
          ],
          "as": [
            "dogs",
            "rate",
            "residents"
          ]
        },
        {
          "type": "formula",
          "as": "metro",
          "expr": "indexof(['Adelaide', 'Burnside', 'Campbelltown (SA)', 'Charles Sturt', 'Gawler', 'Holdfast Bay', 'Marion', 'Mitcham', 'Norwood Payneham and St Peters', 'Onkaparinga', 'Playford', 'Port Adelaide Enfield', 'Prospect', 'Salisbury', 'Tea Tree Gully', 'Unley', 'Walkerville', 'West Torrens'], datum.properties.lga_name_2025) >= 0"
        },
        {
          "type": "formula",
          "as": "tooltip",
          "expr": "{'title': datum.name, 'Dogs recorded at home': format(datum.dogs, ','), 'Dogs per 1,000 residents': format(datum.rate, '.0f'), 'Residents, June 2025': format(datum.residents, ',')}"
        }
      ]
    },
    {
      "name": "south",
      "source": "councils",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum.dogs) && indexof(['Coober Pedy', 'Roxby Downs'], datum.properties.lga_name_2025) < 0"
        }
      ]
    },
    {
      "name": "country",
      "source": "south",
      "transform": [
        {
          "type": "filter",
          "expr": "!datum.metro"
        }
      ],
      "description": "Country councils, drawn individually on the main map."
    },
    {
      "name": "metro",
      "source": "councils",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.metro"
        }
      ]
    },
    {
      "name": "metroTotal",
      "source": "metro",
      "transform": [
        {
          "type": "aggregate",
          "fields": [
            "dogs"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "dogs"
          ]
        },
        {
          "type": "formula",
          "as": "code",
          "expr": "'metro'"
        },
        {
          "type": "formula",
          "as": "name",
          "expr": "'Greater Adelaide (18 councils)'"
        },
        {
          "type": "formula",
          "as": "tooltip",
          "expr": "{'title': 'Greater Adelaide (18 councils)', 'Dogs recorded at home': format(datum.dogs, ','), 'Share of the state\\'s recorded dogs': '61%'}"
        }
      ],
      "description": "Greater Adelaide combined into one circle on the main map so its councils do not pile up."
    },
    {
      "name": "sizeLegend",
      "values": [
        {
          "v": 1000,
          "label": "1,000",
          "i": 0
        },
        {
          "v": 10000,
          "label": "10,000",
          "i": 1
        },
        {
          "v": 50000,
          "label": "50,000",
          "i": 2
        },
        {
          "v": 200000,
          "label": "200,000",
          "i": 3
        }
      ]
    },
    {
      "name": "note",
      "values": [
        {
          "lines": [
            "Greater Adelaide records 61% of the state's",
            "dogs. It has fewer dogs per person, but is",
            "home to 73% of South Australians."
          ]
        }
      ]
    }
  ],
  "projections": [
    {
      "name": "mainProjection",
      "type": "conicEqualArea",
      "parallels": [
        -28,
        -36
      ],
      "rotate": [
        -135,
        0
      ],
      "fit": {
        "signal": "{type: 'FeatureCollection', features: data('south')}"
      },
      "size": {
        "signal": "[mainWidth, mainHeight]"
      }
    }
  ],
  "marks": [
    {
      "type": "group",
      "description": "Main map of the settled south, clipped.",
      "clip": true,
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "y": {
            "value": 0
          },
          "width": {
            "signal": "mainWidth"
          },
          "height": {
            "signal": "mainHeight"
          }
        }
      },
      "marks": [
        {
          "type": "shape",
          "from": {
            "data": "councils"
          },
          "interactive": false,
          "encode": {
            "update": {
              "fill": {
                "signal": "colorBorder"
              },
              "fillOpacity": {
                "value": 0.28
              },
              "stroke": {
                "signal": "colorSurface"
              },
              "strokeWidth": {
                "value": 0.6
              }
            }
          },
          "transform": [
            {
              "type": "geoshape",
              "projection": "mainProjection"
            }
          ]
        },
        {
          "type": "symbol",
          "name": "countryCircles",
          "from": {
            "data": "country"
          },
          "encode": {
            "enter": {
              "tooltip": {
                "signal": "datum.tooltip"
              }
            },
            "update": {
              "x": {
                "signal": "geoCentroid('mainProjection', datum)[0]"
              },
              "y": {
                "signal": "geoCentroid('mainProjection', datum)[1]"
              },
              "size": {
                "signal": "PI * pow(rMax * sqrt(datum.dogs / 200163), 2)"
              },
              "fill": {
                "signal": "colorPetDogs"
              },
              "fillOpacity": {
                "value": 0.72
              },
              "stroke": {
                "signal": "hoverCode === datum.code ? colorHeading : colorSurface"
              },
              "strokeWidth": {
                "signal": "hoverCode === datum.code ? 2.5 : 1"
              },
              "zindex": {
                "signal": "-datum.dogs"
              }
            }
          }
        },
        {
          "type": "symbol",
          "name": "metroCircle",
          "description": "Greater Adelaide's councils combined into one circle.",
          "from": {
            "data": "metroTotal"
          },
          "encode": {
            "enter": {
              "tooltip": {
                "signal": "datum.tooltip"
              }
            },
            "update": {
              "x": {
                "signal": "geoCentroid('mainProjection', {type: 'FeatureCollection', features: data('metro')})[0]"
              },
              "y": {
                "signal": "geoCentroid('mainProjection', {type: 'FeatureCollection', features: data('metro')})[1]"
              },
              "size": {
                "signal": "PI * pow(rMax * sqrt(datum.dogs / 200163), 2)"
              },
              "fill": {
                "signal": "colorPetDogs"
              },
              "fillOpacity": {
                "value": 0.72
              },
              "stroke": {
                "signal": "colorHeading"
              },
              "strokeWidth": {
                "value": 1.5
              }
            }
          }
        },
        {
          "type": "text",
          "description": "Label for the combined Greater Adelaide circle.",
          "from": {
            "data": "metroCircle"
          },
          "interactive": false,
          "encode": {
            "enter": {
              "align": {
                "value": "left"
              },
              "baseline": {
                "value": "middle"
              },
              "fontWeight": {
                "value": 600
              }
            },
            "update": {
              "x": {
                "signal": "datum.x + sqrt(datum.size / PI) + 6"
              },
              "y": {
                "field": "y"
              },
              "text": {
                "signal": "narrow ? ['Greater', 'Adelaide'] : ['Greater Adelaide', format(datum.datum.dogs, ',') + ' dogs']"
              },
              "fontSize": {
                "signal": "narrow ? 11 : 13"
              },
              "lineHeight": {
                "value": 15
              },
              "font": {
                "signal": "fontBody"
              },
              "fill": {
                "signal": "colorHeading"
              }
            }
          }
        }
      ]
    },
    {
      "type": "group",
      "description": "Greater Adelaide inset: its 18 councils at the same circle scale.",
      "encode": {
        "update": {
          "x": {
            "signal": "sideX"
          },
          "y": {
            "signal": "sideY"
          },
          "width": {
            "signal": "sideWidth"
          },
          "height": {
            "signal": "insetHeight"
          },
          "fill": {
            "signal": "colorSurface"
          },
          "stroke": {
            "signal": "colorBorder"
          },
          "strokeWidth": {
            "value": 1
          }
        }
      },
      "projections": [
        {
          "name": "insetProjection",
          "type": "conicEqualArea",
          "parallels": [
            -28,
            -36
          ],
          "rotate": [
            -135,
            0
          ],
          "fit": {
            "signal": "{type: 'FeatureCollection', features: data('metro')}"
          },
          "size": {
            "signal": "[sideWidth - 60, insetHeight - 70]"
          }
        }
      ],
      "marks": [
        {
          "type": "text",
          "interactive": false,
          "encode": {
            "enter": {
              "fontSize": {
                "value": 12
              },
              "fontWeight": {
                "value": 600
              },
              "baseline": {
                "value": "top"
              }
            },
            "update": {
              "x": {
                "value": 8
              },
              "y": {
                "value": 6
              },
              "text": {
                "value": "Greater Adelaide, council by council"
              },
              "font": {
                "signal": "fontBody"
              },
              "fill": {
                "signal": "colorMuted"
              }
            }
          }
        },
        {
          "type": "group",
          "clip": true,
          "encode": {
            "update": {
              "x": {
                "value": 30
              },
              "y": {
                "value": 40
              },
              "width": {
                "signal": "sideWidth - 60"
              },
              "height": {
                "signal": "insetHeight - 70"
              }
            }
          },
          "marks": [
            {
              "type": "shape",
              "from": {
                "data": "metro"
              },
              "interactive": false,
              "encode": {
                "update": {
                  "fill": {
                    "signal": "colorBorder"
                  },
                  "fillOpacity": {
                    "value": 0.28
                  },
                  "stroke": {
                    "signal": "colorSurface"
                  },
                  "strokeWidth": {
                    "value": 0.6
                  }
                }
              },
              "transform": [
                {
                  "type": "geoshape",
                  "projection": "insetProjection"
                }
              ]
            },
            {
              "type": "symbol",
              "name": "metroCircles",
              "from": {
                "data": "metro"
              },
              "encode": {
                "enter": {
                  "tooltip": {
                    "signal": "datum.tooltip"
                  }
                },
                "update": {
                  "x": {
                    "signal": "geoCentroid('insetProjection', datum)[0]"
                  },
                  "y": {
                    "signal": "geoCentroid('insetProjection', datum)[1]"
                  },
                  "size": {
                    "signal": "PI * pow(rMax * sqrt(datum.dogs / 200163), 2)"
                  },
                  "fill": {
                    "signal": "colorPetDogs"
                  },
                  "fillOpacity": {
                    "value": 0.72
                  },
                  "stroke": {
                    "signal": "hoverCode === datum.code ? colorHeading : colorSurface"
                  },
                  "strokeWidth": {
                    "signal": "hoverCode === datum.code ? 2.5 : 1"
                  },
                  "zindex": {
                    "signal": "-datum.dogs"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    {
      "type": "text",
      "name": "noteText",
      "from": {
        "data": "note"
      },
      "interactive": false,
      "zindex": 2,
      "encode": {
        "enter": {
          "baseline": {
            "value": "top"
          },
          "lineHeight": {
            "value": 17
          },
          "fontSize": {
            "value": 12
          },
          "fontStyle": {
            "value": "italic"
          }
        },
        "update": {
          "x": {
            "signal": "sideX + 8"
          },
          "y": {
            "signal": "noteY + 6"
          },
          "text": {
            "field": "lines"
          },
          "font": {
            "signal": "fontBody"
          },
          "fill": {
            "signal": "colorMuted"
          }
        }
      }
    },
    {
      "type": "rect",
      "description": "Plain background sized to the note text; no outline or shadow.",
      "from": {
        "data": "noteText"
      },
      "interactive": false,
      "zindex": 1,
      "encode": {
        "update": {
          "x": {
            "signal": "datum.bounds.x1 - 8"
          },
          "x2": {
            "signal": "datum.bounds.x2 + 8"
          },
          "y": {
            "signal": "noteY"
          },
          "y2": {
            "signal": "datum.bounds.y2 + 6"
          },
          "fill": {
            "signal": "colorPage"
          },
          "cornerRadius": {
            "value": 4
          }
        }
      }
    },
    {
      "type": "text",
      "description": "Size legend title.",
      "interactive": false,
      "encode": {
        "enter": {
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 600
          },
          "baseline": {
            "value": "top"
          },
          "text": {
            "value": "Dogs recorded at home"
          }
        },
        "update": {
          "x": {
            "value": 0
          },
          "y": {
            "signal": "legendY"
          },
          "font": {
            "signal": "fontBody"
          },
          "fill": {
            "signal": "colorMuted"
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "sizeLegend"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "rMax + datum.i * (narrow ? 72 : 110)"
          },
          "y": {
            "signal": "legendY + 22 + rMax - rMax * sqrt(datum.v / 200163)"
          },
          "size": {
            "signal": "PI * pow(rMax * sqrt(datum.v / 200163), 2)"
          },
          "fill": {
            "signal": "colorPetDogs"
          },
          "fillOpacity": {
            "value": 0.72
          },
          "stroke": {
            "signal": "colorSurface"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "sizeLegend"
      },
      "interactive": false,
      "encode": {
        "enter": {
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "top"
          },
          "fontSize": {
            "value": 11
          }
        },
        "update": {
          "x": {
            "signal": "rMax + datum.i * (narrow ? 72 : 110)"
          },
          "y": {
            "signal": "legendY + 22 + rMax + 6"
          },
          "text": {
            "field": "label"
          },
          "font": {
            "signal": "fontBody"
          },
          "fill": {
            "signal": "colorMuted"
          }
        }
      }
    }
  ]
}
